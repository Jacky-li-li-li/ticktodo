{
  "name": "tick",
  "private": true,
  "version": "0.3.0",
  "description": "Tick — AI 会话的索引层：置顶 Todo 工作台",
  "scripts": {
    "dev": "pnpm --filter @tick/tick-extension build && pnpm --filter @tick/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "selftest:prefill": "node scripts/selftest-prefill.mjs",
    "selftest:update": "node scripts/selftest-update.mjs",
    "mcp:build": "pnpm --filter @tick/mcp-server build",
    "mcp:check": "node scripts/mcp-check.mjs",
    "verify:agents": "node scripts/verify-agent-stores.mjs",
    "review:tool": "node scripts/review-tools.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
