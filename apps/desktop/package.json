{
  "name": "@tick/desktop",
  "private": true,
  "version": "0.3.1",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && vite",
    "build": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm run build:mcp && pnpm run build:ext && npm run build && electron-builder --mac",
    "dist:dir": "pnpm run build:mcp && pnpm run build:ext && npm run build && electron-builder --mac dir",
    "build:mcp": "pnpm --filter @tick/mcp-server build",
    "build:ext": "pnpm --filter @tick/tick-extension build"
  },
  "build": {
    "appId": "com.ticktodo.panel",
    "productName": "Tick",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "Developer ID Application",
      "darkModeSupport": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "../../packages/mcp-server/dist/tick-mcp.mjs",
        "to": "mcp/tick-mcp.mjs"
      },
      {
        "from": "build/tick-mcp.sh",
        "to": "mcp/tick-mcp.sh"
      },
      {
        "from": "../../packages/tick-extension/dist/index.js",
        "to": "tick-extension/index.js"
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Jacky-li-li-li",
        "repo": "ticktodo"
      }
    ],
    "electronFuses": {
      "runAsNode": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tick/ai-claude": "workspace:*",
    "@tick/ai-claude-desktop": "workspace:*",
    "@tick/ai-cline": "workspace:*",
    "@tick/ai-codex": "workspace:*",
    "@tick/ai-core": "workspace:*",
    "@tick/ai-dsh": "workspace:*",
    "@tick/ai-grok": "workspace:*",
    "@tick/ai-kimi": "workspace:*",
    "@tick/ai-omp": "workspace:*",
    "@tick/ai-opencode": "workspace:*",
    "@tick/ai-pi": "workspace:*",
    "@tick/ai-qoder": "workspace:*",
    "@tick/ai-workbuddy": "workspace:*",
    "@tick/ai-workbuddy-ai": "workspace:*",
    "@tick/ai-zcode": "workspace:*",
    "@tick/shared": "workspace:*",
    "@tick/tick-extension": "workspace:*",
    "@tick/todo-core": "workspace:*",
    "@tick/ui": "workspace:*",
    "electron-updater": "6.8.9",
    "openai": "7.19.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.8"
  }
}
